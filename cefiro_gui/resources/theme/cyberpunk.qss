
/* CEFIRO Qt6 HMI · original QUBE-Servo 2 structural conventions */
* { font-family: "Inter", "Segoe UI", "DejaVu Sans", sans-serif; font-size:11px; }
QMainWindow, QWidget, QDialog { background: #050510; color: #eaf2ff; }
QToolBar#topbar { background: #0b0b18; border:0; border-bottom:1px solid #342159; spacing:8px; padding:7px; }
QTabBar#topTabs::tab { background:transparent; color:#8aa0c8; border:0; padding:11px 20px; font-weight:700; }
QTabBar#topTabs::tab:selected { color:#ff2bd6; border-bottom:2px solid #ff2bd6; }
QLabel#pageTitle { font-size:22px; font-weight:900; color:#ff2bd6; }
QLabel#pageSubtitle, QLabel#hint { color:#8aa0c8; font-size:10px; }
QLabel#eyebrow { color:#8aa0c8; font-size:9px; font-weight:700; }
QLabel#panelTitle, QLabel#chartTitle { color:#00f5ff; font-size:11px; font-weight:800; }
QLabel#metricValue { color:#eaf2ff; font-size:13px; font-weight:700; }
QLabel#topologyLine { background:#0b0b18; border:1px solid #342159; padding:12px; color:#eaf2ff;font-size:11px;font-weight:700; }
QFrame#panel { background:#0b0b18; border:1px solid #342159; border-radius:6px; }
QFrame#chartFrame { background:transparent; border:none; }
QFrame#hudSeparator { color:#342159; background:#342159; max-height:1px; }
QScrollArea { border:0; background:transparent; }
QScrollBar:vertical { background:#050510; width:8px; }
QScrollBar::handle:vertical {background:#342159; border-radius:3px; min-height:20px;}
QScrollBar::add-line:vertical,QScrollBar::sub-line:vertical {height:0;}
QPushButton, QToolButton, QComboBox, QDoubleSpinBox { background:#0b0b18; color:#eaf2ff; border:1px solid #342159; border-radius:4px; padding:6px 9px; min-height:18px; }
QPushButton:hover,QToolButton:hover,QComboBox:hover {border:1px solid #00f5ff;}
QPushButton:pressed {background:#342159;}
QPushButton:disabled {color:#8aa0c8;}
QPushButton#primaryAction {background:#ff2bd6; border:1px solid #ff2bd6; color:#050510; font-weight:900;}
QPushButton#emergencyButton {background:#fc4767; border:1px solid #fc4767; color:#ffffff; font-weight:900;}
QPushButton#recordButton {background:#0b0b18; border:1px solid #ff2bd6; color:#ff2bd6; font-weight:850;}
QPushButton#sourceModeButton:checked {color:#ff2bd6; border:1px solid #ff2bd6; font-weight:800;}
QToolButton#chartToolButton {padding:0px 5px; border:0px; min-height:17px; font-size:10px; color:#00f5ff; }
QLabel#chartWindowLabel {color:#8aa0c8; min-width:35px; font-size:10px;}
QGroupBox { border:1px solid #342159; border-radius:4px; margin-top:12px; padding:10px 7px 6px 7px; font-weight:750; color:#00f5ff; }
QGroupBox::title { subcontrol-origin:margin; left:8px; padding:0px 4px; }
QTabWidget::pane {border:1px solid #342159; border-radius:3px;}
QTabBar::tab { background:#0b0b18; border:1px solid #342159; color:#8aa0c8; padding:7px 13px; }
QTabBar::tab:selected {color:#ff2bd6; border-bottom:2px solid #ff2bd6;}
QTableWidget,QHeaderView::section {background:#0b0b18; color:#eaf2ff; border:1px solid #342159; gridline-color:#342159;padding:3px;}
QStatusBar {background:#0b0b18; color:#8aa0c8; border-top:1px solid #342159;}
QToolTip {background:#0b0b18; border:1px solid #00f5ff; color:#eaf2ff; padding:6px; }
QCheckBox {color:#eaf2ff; spacing:8px;}
QCheckBox::indicator {width:14px;height:14px;}
QCheckBox::indicator:checked {background:#ff2bd6;border:1px solid #ff2bd6;}
