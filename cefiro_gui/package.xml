<?xml version="1.0"?>
<package format="3">
  <name>cefiro_gui</name>
  <version>1.0.0</version>
  <description>Qt6 ROS 2 attitude control HMI, telemetry, signal generator and experiment logger for CEFIRO.</description>
  <maintainer email="maintainers@example.invalid">CEFIRO Development Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
