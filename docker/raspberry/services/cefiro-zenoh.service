[Unit]
Description=CEFIRO Zenoh ROS 2 DDS bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
EnvironmentFile=/etc/cefiro/pi-services.env
ExecStart=/usr/local/lib/cefiro/run-zenoh.sh
Restart=always
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
