// Raspberry Pi 192.168.68.59; native ROS 2 nodes live in DDS domain 30.
// This bridge exports ONLY the selected telemetry topics via Zenoh TCP.
// Use on a trusted LAN only: no authentication/TLS is configured here.
{
  mode: "router",
  listen: { endpoints: ["tcp/192.168.68.59:7447"] },
  scouting: {
    multicast: { enabled: false },
    gossip: { enabled: false }
  },
  plugins: {
    ros2dds: {
      domain: 30,
      ros_automatic_discovery_range: "SUBNET",
      allow: {
        publishers: [
          "^/real/imu/data$",
          "^/real/magnetometer/data$",
          "^/real/bmp581/air_pressure$",
          "^/real/cefiro/hardware/status$",
          "^/real/cefiro/control/status$",
          "^/real/cefiro_actuators/telemetry$",
          "^/real/cefiro_actuators/measured_rpm$"
        ],
        subscribers: [],
        service_servers: [],
        service_clients: [],
        action_servers: [],
        action_clients: []
      }
    }
  }
}
