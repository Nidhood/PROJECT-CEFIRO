<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- The board is part of the measured drone mass and the frame STL.
       The meshless fixed links preserve sensor TF frames; all Gazebo sensors
       are attached to drone_body_link, with no sensor visual/collision meshes. -->
  <xacro:property name="sensor_mm_to_m" value="${0.001}"/>

  <!-- Meshless sensor TF frames. Gazebo lumps these fixed child frames into
       drone_body_link; sensors are attached directly to the body in SDF. -->
  <xacro:macro name="cefiro_fmu_chip" params="name parent mount">
    <!-- Tiny valid inertial avoids URDF parser warnings; no visual or collision.
         These masses are numerical placeholders and not characterized. -->
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia ixx="1e-10" ixy="0" ixz="0" iyy="1e-10" iyz="0" izz="1e-10"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${mount['offset_mm'][0] * sensor_mm_to_m} ${mount['offset_mm'][1] * sensor_mm_to_m} ${mount['offset_mm'][2] * sensor_mm_to_m}"
              rpy="${mount['rpy'][0]} ${mount['rpy'][1]} ${mount['rpy'][2]}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="cefiro_fmu_sensors" params="config">
    <xacro:property name="mount" value="${config['fmu_mount']}"/>
    <xacro:property name="imu" value="${config['imu_icm42670p']}"/>
    <xacro:property name="mag" value="${config['magnetometer_mmc5983ma']}"/>
    <xacro:property name="baro" value="${config['bmp581']}"/>

    <!-- The top face of the FMU mesh occupies X=[29,69], Y=[-14.5,85.5]
         and is at Z=54.1014 mm in the drone_body_link CAD frame. -->
    <link name="fmu_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.00001"/>
        <inertia ixx="1e-10" ixy="0" ixz="0" iyy="1e-10" iyz="0" izz="1e-10"/>
      </inertial>
    </link>
    <joint name="drone_to_fmu_mount" type="fixed">
      <parent link="${mount['parent']}"/>
      <child link="fmu_mount_link"/>
      <origin xyz="${mount['origin_mm'][0] * sensor_mm_to_m} ${mount['origin_mm'][1] * sensor_mm_to_m} ${mount['origin_mm'][2] * sensor_mm_to_m}"
              rpy="${mount['origin_rpy'][0]} ${mount['origin_rpy'][1]} ${mount['origin_rpy'][2]}"/>
    </joint>


    <xacro:cefiro_fmu_chip name="imu_icm42670p" parent="fmu_mount_link"
      mount="${imu}"/>
    <xacro:cefiro_fmu_chip name="magnetometer_mmc5983ma" parent="fmu_mount_link"
      mount="${mag}"/>
    <xacro:cefiro_fmu_chip name="bmp581" parent="fmu_mount_link"
      mount="${baro}"/>

    <!-- Gazebo Harmonic sensor systems are enabled in main_world.sdf.
         Attach each Gazebo sensor directly to the physical drone body.
         Therefore fixed-joint lumping cannot discard the Gazebo sensors.
         The current mount/chip orientation values are all zero in YAML;
         sensor pose XYZ equals FMU mount + chip offset in this configuration.
         If board RPY is changed, update these pose expressions to rotate
         chip offsets using the board orientation. TF chip links remain. -->
    <gazebo reference="${mount['parent']}">
      <sensor name="imu_icm42670p" type="imu">
        <pose>${(mount['origin_mm'][0] + imu['offset_mm'][0]) * sensor_mm_to_m} ${(mount['origin_mm'][1] + imu['offset_mm'][1]) * sensor_mm_to_m} ${(mount['origin_mm'][2] + imu['offset_mm'][2]) * sensor_mm_to_m} ${mount['origin_rpy'][0] + imu['rpy'][0]} ${mount['origin_rpy'][1] + imu['rpy'][1]} ${mount['origin_rpy'][2] + imu['rpy'][2]}</pose>
        <always_on>true</always_on>
        <update_rate>${imu['update_rate_hz']}</update_rate>
        <topic>/imu/data</topic>
        <gz_frame_id>imu_icm42670p_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00122173</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00122173</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00122173</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00980665</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00980665</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00980665</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <gazebo reference="${mount['parent']}">
      <sensor name="magnetometer_mmc5983ma" type="magnetometer">
        <pose>${(mount['origin_mm'][0] + mag['offset_mm'][0]) * sensor_mm_to_m} ${(mount['origin_mm'][1] + mag['offset_mm'][1]) * sensor_mm_to_m} ${(mount['origin_mm'][2] + mag['offset_mm'][2]) * sensor_mm_to_m} ${mount['origin_rpy'][0] + mag['rpy'][0]} ${mount['origin_rpy'][1] + mag['rpy'][1]} ${mount['origin_rpy'][2] + mag['rpy'][2]}</pose>
        <always_on>true</always_on>
        <update_rate>${mag['update_rate_hz']}</update_rate>
        <topic>/magnetometer/data</topic>
        <gz_frame_id>magnetometer_mmc5983ma_link</gz_frame_id>
        <magnetometer>
          <x><noise type="gaussian"><mean>0</mean><stddev>1.2e-7</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1.2e-7</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1.2e-7</stddev></noise></z>
        </magnetometer>
      </sensor>
    </gazebo>

    <gazebo reference="${mount['parent']}">
      <sensor name="bmp581_barometer" type="air_pressure">
        <pose>${(mount['origin_mm'][0] + baro['offset_mm'][0]) * sensor_mm_to_m} ${(mount['origin_mm'][1] + baro['offset_mm'][1]) * sensor_mm_to_m} ${(mount['origin_mm'][2] + baro['offset_mm'][2]) * sensor_mm_to_m} ${mount['origin_rpy'][0] + baro['rpy'][0]} ${mount['origin_rpy'][1] + baro['rpy'][1]} ${mount['origin_rpy'][2] + baro['rpy'][2]}</pose>
        <always_on>true</always_on>
        <update_rate>${baro['update_rate_hz']}</update_rate>
        <topic>/bmp581/air_pressure</topic>
        <gz_frame_id>bmp581_link</gz_frame_id>
        <visualize>false</visualize>
        <air_pressure>
          <reference_altitude>0</reference_altitude>
          <pressure>
            <noise type="gaussian_quantized">
              <mean>0</mean><stddev>0.21</stddev>
              <bias_mean>0</bias_mean><bias_stddev>10</bias_stddev>
              <precision>0.015625</precision>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
