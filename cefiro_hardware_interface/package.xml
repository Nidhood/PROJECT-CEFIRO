<?xml version="1.0"?>
<package format="3">
  <name>cefiro_hardware_interface</name>
  <version>0.1.0</version>
  <description>Raspberry Pi USB-USART adapter for the real CEFIRO_FMU_V3; separate /real ROS 2 topics.</description>
  <maintainer email="maintainers@example.invalid">CEFIRO Development Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cefiro_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
