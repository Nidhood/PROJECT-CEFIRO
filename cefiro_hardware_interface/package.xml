<?xml version="1.0"?>
<package format="3">
  <name>cefiro_hardware_interface</name>
  <version>0.4.1</version>
  <description>C++20 ROS 2 Jazzy bridge between CEFIRO Qt6 GUI and the actual STM32 CF1 DShot/IMU interface under /real.</description>
  <maintainer email="maintainers@example.invalid">CEFIRO Development Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cefiro_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
