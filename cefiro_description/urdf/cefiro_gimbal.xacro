<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="cefiro_gimbal" params="config">
    <xacro:property name="L" value="${config['links']}"/>
    <xacro:property name="J" value="${config['joints']}"/>

    <!-- Base of gimbal -->
    <xacro:cefiro_link link_name="base_link" config="${L['base_link']}"/>

    <!-- Lower ring rotates about original yaw pivot -->
    <xacro:cefiro_link link_name="narya_ring" config="${L['narya_ring']}"/>

    <!-- Central ring rotates with Narya and adds pitch -->
    <xacro:cefiro_link link_name="vilya_ring" config="${L['vilya_ring']}"/>
    
    <!-- Inner ring rotates with Narya/Vilya and adds roll -->
    <xacro:cefiro_link link_name="nenya_ring" config="${L['nenya_ring']}"/>

    <xacro:cefiro_joint joint_name="yaw" config="${J['yaw']}"/>
    <xacro:cefiro_joint joint_name="pitch" config="${J['pitch']}"/>
    <xacro:cefiro_joint joint_name="roll" config="${J['roll']}"/>

    <!-- World reference -->
    <link name="world"/>

    <!-- Anchor the gimbal base to the world -->
    <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
  </xacro:macro>
</robot>
