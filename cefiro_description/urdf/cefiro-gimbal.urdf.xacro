<?xml version="1.0"?>
<robot name="cefiro_gimbal" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find cefiro_description)/urdf/cefiro_utils.xacro"/>
  <xacro:include filename="$(find cefiro_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find cefiro_description)/urdf/cefiro_gimbal.xacro"/>
  <xacro:arg name="physical_config_file" default="$(find cefiro_description)/config/cefiro_params.yaml"/>
  <xacro:arg name="visual_mode" default="separated"/>
  <xacro:arg name="enable_collision" default="true"/>
  <xacro:property name="P" value="${xacro.load_yaml('$(arg physical_config_file)')['cefiro']}"/>
  <xacro:cefiro_gimbal config="${P}"/>
  
</robot>
